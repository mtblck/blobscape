+
+    /// The current splats as the bytes of a .ply file, read back from the
+    /// GPU. Resolves to `undefined` if no splats have been produced yet.
+    #[wasm_bindgen(js_name = exportPly)]
+    pub async fn export_ply(&self) -> Result<Option<Vec<u8>>, JsValue> {
+        let Some(splats) = self.splat_view.latest() else {
+            return Ok(None);
+        };
+        brush_serde::splat_to_ply(splats, None)
+            .await
+            .map(Some)
+            .map_err(|e| js_err_str(&format!("{e:#}")))
+    }
 }
 
