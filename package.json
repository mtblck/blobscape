{
  "name": "blobscape",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite",
    "build": "npm run hosting:check && tsc && vite build && npm run prerender",
    "preview": "vite preview",
    "hosting:check": "node scripts/check-hosting.mjs",
    "test": "node --test --experimental-strip-types 'src/**/*.test.ts'",
    "verify": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/verify.mjs",
    "prerender": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/prerender.ts"
  },
  "dependencies": {
    "@sparkjsdev/spark": "^2.4.0",
    "nodemailer": "^10.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "tipjar": "^2.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "playwright-core": "^1.65.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  },
  "private": true,
  "type": "module"
}
