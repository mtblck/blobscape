{
  "name": "blobscape",
  "version": "0.2.0",
  "scripts": {
    "dev": "vite",
    "build": "npm run hosting:check && tsc && vite build && node scripts/build-element.mjs && npm run prerender",
    "engine:build": "node scripts/build-engine.mjs",
    "docs:deps": "test -d tools/api-docs/node_modules/typedoc || npm --prefix tools/api-docs ci --ignore-scripts",
    "docs": "npm run docs:deps && npm --prefix tools/api-docs run build",
    "preview": "vite preview",
    "hosting:check": "node scripts/check-hosting.mjs",
    "test": "node --test --experimental-strip-types 'src/**/*.test.ts' 'scripts/*.test.mjs'",
    "verify": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/verify.mjs",
    "verify:changed": "npm run verify -- --changed",
    "check": "npm run docs:deps && npm test && npm run build && npm run verify -- --changed",
    "prerender": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/prerender.ts",
    "release": "node scripts/release.mjs",
    "scene": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/scene.mjs"
  },
  "dependencies": {
    "@sparkjsdev/spark": "^2.4.0",
    "mp4-muxer": "5.2.2",
    "nodemailer": "^10.6.0",
    "onnxruntime-web": "1.22.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "tipjar": "^2.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "playwright-core": "^1.65.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  },
  "private": true,
  "license": "MIT",
  "type": "module"
}
