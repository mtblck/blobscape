{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/experiments",
      "has": [
        {
          "type": "host",
          "value": "experiments-theta-inky.vercel.app"
        }
      ],
      "destination": "https://blobscape.dev/experiments/",
      "permanent": true
    },
    {
      "source": "/experiments/blobscape/:path*",
      "destination": "https://blobscape.dev/",
      "permanent": true
    },
    {
      "source": "/experiments/fit-a-picture/:path*",
      "destination": "https://blobscape.dev/tools/fit-a-picture/",
      "permanent": true
    },
    {
      "source": "/experiments/splat-to-sprite/:path*",
      "destination": "https://blobscape.dev/tools/splat-to-sprite/",
      "permanent": true
    },
    {
      "source": "/experiments/engine-lab/:path*",
      "destination": "https://blobscape.dev/engine-lab/",
      "permanent": true
    },
    {
      "source": "/experiments/:path*",
      "has": [
        {
          "type": "host",
          "value": "experiments-theta-inky.vercel.app"
        }
      ],
      "destination": "https://blobscape.dev/experiments/",
      "permanent": true
    },
    {
      "source": "/tools",
      "destination": "/experiments/",
      "permanent": false
    },
    {
      "source": "/tools/",
      "destination": "/experiments/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self' blob: data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
